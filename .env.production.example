# Required production identity and host configuration.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=True
SITE_URL=https://app.example.com

# PostgreSQL. Replace every uppercase placeholder before use.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME

# Persistent public uploads. Use the exact filesystem path and public URL/path
# supplied by the hosting provider; the values below illustrate this deployment.
MEDIA_ROOT=/home/tap2connectnepal.com/public_html/shared/media
MEDIA_URL=/shared/media/

# Keep this outside every publicly served directory. Replace the placeholder
# with the hosting provider's exact private filesystem path.
PRIVATE_CARD_MEDIA_ROOT=/ABSOLUTE/PRIVATE/PATH/private_card_media

# HTTPS reverse proxy and cookie security.
TRUST_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO

# SMTP email delivery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Optional application integration.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
